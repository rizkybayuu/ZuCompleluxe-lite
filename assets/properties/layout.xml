        <Door id="10" doorX="559" doorY="49"  frogX="606" frogY="121" />
        <Door id="11" doorX="669" doorY="49"  frogX="724" frogY="120" />

        <!-- Secret Temple 5 Door (The Void: Stage 13) -->
        <Door id="12" doorX="559" doorY="248" frogX="604" frogY="283" />
