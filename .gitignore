# Logs
*.log
build_*.log

# Temporary and backup directories
.backup/
.testing/
.build/
.test/
build_tmp/

# Compiled output directories (generated by build_full.bat / build_lite.bat, never committed)
modules/
binary/

# Local vanilla game assets (never commit commercial game binaries)
vanilla/
base/
.base/

# Python bytecode
__pycache__/
*.pyc

# OS / Editor files
.DS_Store
Thumbs.db
thumbs.af
*.swp
*.bak

# Decompiled source dumps & raw vanilla dumps (kept local for analysis, not distributed)
.*
!.gitignore
!.gitattributes

# Per-subdirectory dot-prefixed local notes (Ghidra dumps, decompiled output, internal analysis)
src/.*
docs/.*
builder/.*
assets/.*

# Decompiled vanilla source files (root-level legacy names)
Zuma.exe.c
Zuma.exe.h
bass.dll.c
zumares.dll.c

# Local tool cache (auto-downloaded compilers, UPX, etc.)
tools/
.tools/
builder/.tools/

# Import / string scan artefacts
*.imports.txt
*.strings.txt
.imports.txt
.strings.txt

# One-off audit / investigation scripts
builder/audit_*.py
builder/tugas_*.py
builder/analyze_*.py
builder/find_*.py
!builder/find_target_exe.py
builder/test_new_ball_ops.py
*.tmp
err.txt

# Build intermediate objects and debug symbols
*.obj
*.lib
*.exp
*.pdb
src/*.obj
src/*.lib
src/*.exp
src/*.pdb
build/
